;; Basilisp surface dump.
;;
;; Basilisp is a Clojure-shaped Lisp on Python 3. It exposes
;; ns-publics / find-ns / meta / require like JVM Clojure, but the
;; host's exception model is Python (no java.lang.Throwable), and
;; env-var access goes through Python's `os.getenv` rather than
;; `System/getenv` — both of which the portable surface_dump.cljc
;; assumes.
;;
;; This script mirrors surface_dump_clojerl.clje: same structure,
;; same EDN output shape, host-specific calls swapped in.
;;
;; Diagnostics go to stderr; never stdout (would corrupt EDN).

(import os)
(require '[clojure.edn :as edn]
         '[clojure.string :as str])

(defn- get-env [k]
  (.getenv os k))

(def ^:private clojure-spec-path
  (or (get-env "CLOJURE_SPEC_PATH")
      "clojure/spec.edn"))

(def ^:private dialect-tag
  (or (get-env "DIALECT_TAG") "basilisp"))

(defn- read-target-namespaces []
  (try
    (let [data (edn/read-string (slurp clojure-spec-path))]
      (mapv :ns (:target-namespaces data)))
    (catch Exception e
      (binding [*out* *err*]
        (println "; could not read clojure-spec at" clojure-spec-path "--" (str e)))
      [])))

(defn- silent-try-require [ns-sym]
  (try (require ns-sym) true (catch Exception _ false)))

(defn- resolve-basilisp-ns
  "Basilisp ships its stdlib as basilisp.* (basilisp.core, basilisp.string,
  …) — there is no `clojure.core` namespace on the Python host. For each
  clojure.X target, try clojure.X first (in case future Basilisp adds
  aliasing), then fall back to basilisp.X. Returns the loaded namespace
  object, or nil if neither resolves."
  [target-sym]
  (let [target-name (str target-sym)
        alt-sym (when (str/starts-with? target-name "clojure.")
                  (symbol (str/replace target-name #"^clojure\." "basilisp.")))
        candidates (if alt-sym [target-sym alt-sym] [target-sym])]
    (some (fn [sym]
            (when (silent-try-require sym) (find-ns sym)))
          candidates)))

(defn- safe-tag [t]
  (when t
    (try (str t) (catch Exception _ nil))))

(defn- capture-var-meta [v]
  (try
    (let [m (meta v)]
      (cond-> {}
        (:arglists m)        (assoc :arglists (:arglists m))
        (string? (:doc m))   (assoc :doc      (:doc m))
        (string? (:added m)) (assoc :added    (:added m))
        (:macro m)           (assoc :macro    true)
        (:dynamic m)         (assoc :dynamic  true)
        (:tag m)             (assoc :tag      (safe-tag (:tag m)))
        (string? (:file m))  (assoc :file     (:file m))
        (integer? (:line m)) (assoc :line     (:line m))))
    (catch Exception _ {})))

(defn- capture-namespace [target-sym]
  (when-let [n (resolve-basilisp-ns target-sym)]
    (try
      {:vars (into {}
                   (map (fn [[var-name v]] [var-name (capture-var-meta v)]))
                   (ns-publics n))}
      (catch Exception e
        (binding [*out* *err*]
          (println "; could not capture" target-sym "--" (str e)))
        {:vars {}}))))

(def ^:private candidate-special-forms
  '[def if do let fn quote var loop recur try throw new . set!
    monitor-enter monitor-exit catch finally])

(defn- capture-special-forms []
  (try
    (set (filter (fn [s]
                   (try (special-symbol? s)
                        (catch Exception _ false)))
                 candidate-special-forms))
    (catch Exception _ #{})))

(defn- capture-spec-keys []
  (try
    (when (find-ns 'clojure.spec.alpha)
      (when-let [reg (resolve 'clojure.spec.alpha/registry)]
        (try (set (keys (@reg))) (catch Exception _ #{}))))
    (catch Exception _ #{})))

(defn- dialect-clojure-version []
  ;; Basilisp doesn't expose `clojure-version` as a function (it tracks
  ;; *basilisp-version* instead). Guard with `resolve` so the script
  ;; degrades gracefully on any dialect that's missing the symbol.
  (try
    (if-let [v (resolve 'clojure-version)]
      (@v)
      "unknown")
    (catch Exception _ "unknown")))

(defn -main [& _]
  (let [targets    (read-target-namespaces)
        ;; capture-namespace handles the clojure.X → basilisp.X fallback
        ;; internally, so we iterate targets directly and key the result
        ;; by the canonical clojure.X name.
        namespaces (into {}
                         (keep (fn [target-sym]
                                 (when-let [data (capture-namespace target-sym)]
                                   [target-sym data])))
                         targets)
        surface    {:dialect-tag     dialect-tag
                    :clojure-version (dialect-clojure-version)
                    :namespaces      namespaces
                    :special-forms   (capture-special-forms)
                    :spec-keys       (or (capture-spec-keys) #{})}]
    (binding [*print-namespace-maps* false
              *print-length*         nil
              *print-level*          nil]
      (println (pr-str surface)))))

(-main)
