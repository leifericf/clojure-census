;; Basilisp -- a Clojure-shaped Lisp hosted on Python 3.
;;
;; Installation:
;;   pipx install basilisp                  # macOS / Linux
;;   pip install --user basilisp            # if pipx unavailable
;;
;; Requires its own surface_dump_basilisp.lpy because the portable
;; .cljc script uses `System/getenv` and `(catch Throwable ...)`,
;; neither of which exists on the Python host. The dedicated script
;; swaps those for `(.getenv os ...)` and `(catch python/Exception ...)`.
{:name             "Basilisp"
 :tag              "basilisp"
 :role             :sut
 :invocation       {:type :subprocess
                    :cmd  ["basilisp" "run" "scripts/surface_dump_basilisp.lpy"]}
 :version-cmd      ["basilisp" "version"]

 ;; Initial namespace coverage list. Basilisp ships a Clojure-shaped
 ;; clojure.core plus a partial stdlib; this list will refine after
 ;; the first surface dump validates which Clojure (JVM) namespaces have a
 ;; resolvable analogue.
 :participates-in  [clojure.core
                    clojure.string
                    clojure.set
                    clojure.walk
                    clojure.test
                    clojure.template
                    clojure.edn
                    clojure.pprint
                    clojure.data]
 :data-dir         "data/basilisp"
 :output-dir       "output/basilisp"
 :surface-normalization :default

 ;; Basilisp's eval is Python-hosted; the portable behavior_eval
 ;; script relies on JVM-shaped interop (System/currentTimeMillis,
 ;; java.lang.Class). A Basilisp-specific evaluator can replace this
 ;; flag once authored.
 :behavior {:enabled false}}
