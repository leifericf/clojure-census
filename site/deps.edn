{:paths ["src" "resources"]

 :deps {org.clojure/clojure       {:mvn/version "1.12.4"}
        hiccup/hiccup             {:mvn/version "2.0.0-RC5"}
        garden/garden             {:mvn/version "1.3.10"}
        stasis/stasis             {:mvn/version "2023.11.21"}
        ring/ring-jetty-adapter   {:mvn/version "1.13.0"}}

 :aliases
 {;; Build the static site into site/public/.
  :build
  {:main-opts ["-m" "clj-canon-parity.site.core" "build"]}

  ;; Serve the site at http://localhost:8000 with hot reload.
  :dev
  {:main-opts ["-m" "clj-canon-parity.site.core" "dev"]}

  ;; Run the site's own unit tests.
  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts   ["-m" "cognitect.test-runner"]}}}
