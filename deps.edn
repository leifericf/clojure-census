{:paths ["src" "resources"]

 :deps  {org.clojure/clojure       {:mvn/version "1.12.4"}
         org.clojure/tools.cli     {:mvn/version "1.1.230"}
         org.clojure/data.json     {:mvn/version "2.5.0"}}

 :aliases
 {;; Run the unit + property test suite.
  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                 org.clojure/test.check {:mvn/version "1.1.1"}}
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test}

  ;; Schema-validate every EDN under canon/, dialects/, data/.
  ;; Non-zero exit on the first malformed entry.
  :validate-data
  {:main-opts ["-m" "clj-canon-parity.main" "validate-data"]}

  ;; Run the pipeline. Use `-- --help` to see options.
  ;; Examples:
  ;;   clojure -M:run dump   --dialect mino
  ;;   clojure -M:run diff   --dialect mino
  ;;   clojure -M:run render --dialect mino
  :run
  {:main-opts ["-m" "clj-canon-parity.main"]}

  ;; Site: Stasis dev server (proxies into site/ via :local/root).
  ;;   clojure -M:dev
  :dev
  {:replace-deps  {com.leifericf/clojure-canon-parity-site
                   {:local/root "site"}}
   :replace-paths []
   :main-opts     ["-m" "clj-canon-parity.site.core" "dev"]}

  ;; Site: one-shot static build into site/public/.
  ;;   clojure -M:build
  :build
  {:replace-deps  {com.leifericf/clojure-canon-parity-site
                   {:local/root "site"}}
   :replace-paths []
   :main-opts     ["-m" "clj-canon-parity.site.core" "build"]}}}
