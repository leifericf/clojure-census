;; Behavior cases for clojure.core/class. class is a real concrete-tag
;; function in mino (not an alias of type): nil -> nil, records -> the
;; record's type symbol, every other value -> its type keyword. The
;; nil case is a true match (oracle nil = mino nil); the non-nil cases
;; are the same Class-vs-keyword divergence as `type` -- see
;; data/behavior/clojure.core/type.edn.
[{:id          :class/string
  :var         clojure.core/class
  :category-id :type-system
  :form        (class "abc")
  :tags        #{:happy-path}}

 {:id          :class/long
  :var         clojure.core/class
  :category-id :type-system
  :form        (class 42)
  :tags        #{:happy-path}}

 {:id          :class/keyword
  :var         clojure.core/class
  :category-id :type-system
  :form        (class :foo)
  :tags        #{:happy-path}}

 {:id          :class/nil
  :var         clojure.core/class
  :category-id :type-system
  :form        (class nil)
  :tags        #{:happy-path}}]
