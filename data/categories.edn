;; Classification dimensions used by divergences and extensions.
;;
;; Each entry's :id is a foreign key referenced by
;; data/<dialect>/divergences.edn and data/<dialect>/extensions.edn.
;;
;; Adding a new dimension = adding an entry here. No code change.
[{:id          :ordering
  :title       "Ordering & comparison"
  :description "How sort, compare, and ordered iteration work."}

 {:id          :type-system
  :title       "Type-system representation"
  :description "How type, class, and dispatch report a value's kind."}

 {:id          :numeric-tower
  :title       "Numeric tower"
  :description "Integer tiers, ratio promotion, float precision."}

 {:id          :reader
  :title       "Reader behavior"
  :description "Reader macros, literal forms, source-meta attachment."}

 {:id          :printer
  :title       "Printer behavior"
  :description "pr-str output for various values and dynamic-var states."}

 {:id          :collections
  :title       "Collection semantics"
  :description "Iteration order, equality, hash, structural sharing."}

 {:id          :concurrency
  :title       "Concurrency primitives"
  :description "Atoms, refs, agents, futures, core.async behavior."}

 {:id          :error-messages
  :title       "Error message shapes"
  :description "Exception types, ex-data shapes, message phrasing."}

 {:id          :jvm-statics
  :title       "JVM-static value remap"
  :description "JVM-only statics remapped to dialect-native equivalents."}

 {:id          :namespaces
  :title       "Namespace mechanics"
  :description "ns, require, refer, alias, var resolution semantics."}

 {:id          :macros
  :title       "Macro semantics"
  :description "Syntax-quote, macroexpansion order, hygiene."}

 {:id          :metadata
  :title       "Metadata propagation"
  :description "Where reader attaches meta and which ops preserve it."}]
