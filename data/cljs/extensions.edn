;; ClojureScript host-specific extensions beyond Clojure (JVM).
;;
;; CLJS exposes namespaces and operations that don't fit Clojure (JVM)
;; (js-related interop, host IO via planck.io etc.). The v1 parity
;; comparison is scoped to Clojure (JVM)'s clojure.* target list, so these
;; entries are documentation only -- they don't surface as
;; :dialect-only in the comparison.
[
 {:id             :js-interop-syntax
  :title          "JavaScript-host interop sugar"
  :affected-names ["cljs.core/js->clj"
                   "cljs.core/clj->js"
                   "cljs.core/array"
                   "cljs.core/aclone"
                   "cljs.core/aget"
                   "cljs.core/aset"]
  :category-id    :jvm-statics
  :rationale      "Bidirectional conversion between CLJS data and JS
                   data, plus typed-array helpers. Necessary for JS
                   host interop; absent from Clojure (JVM) by design."
  :since          "cljs-0.1"}

 {:id             :spec-gen-cljs-alpha
  :title          "cljs.spec.gen.alpha for generator wiring"
  :affected-names ["cljs.spec.gen.alpha/generator"
                   "cljs.spec.gen.alpha/sample"]
  :category-id    :collections
  :rationale      "Generator-side surface for cljs.spec.alpha; Clojure (JVM)
                   exposes the equivalent via clojure.spec.gen.alpha.
                   Captured as a cljs.* namespace for documentation;
                   not in the v1 :include-only-namespaces filter."
  :since          "cljs-0.1"}
]
