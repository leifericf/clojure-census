 :divergences
 [{:id :beam-host,
   :title "Host runtime is the BEAM, not the JVM",
   :category-id :jvm-statics,
   :rationale
   "Interop targets Erlang modules. JVM-static names\n                    (System/getenv, Math/PI, java.io.File) do not\n                    resolve; equivalents reach into OTP's `os`,\n                    `math`, `file`, `binary`, etc. via Clojerl's\n                    erlang/* shim namespace.",
   :since "clojerl-0.1",
   :doc-link "https://github.com/clojerl/clojerl"}
  {:id :erlang-exception-model,
   :title "Exceptions are Erlang errors, not JVM Throwables",
   :category-id :error-messages,
   :rationale
   "Erlang raises errors tagged as `error`, `throw`,\n                    or `exit`. Clojerl's catch syntax is\n                    `(catch _ e ...)` for any kind of error;\n                    `(catch :error reason ...)` for a specific Erlang\n                    error class. Portable code that catches JVM\n                    exception classes must use a :clje reader\n                    conditional.",
   :since "clojerl-0.1",
   :doc-link "https://www.erlang.org/doc/system/errors.html"}
  {:id :actor-concurrency,
   :title "Concurrency is process-and-message, not shared-state",
   :category-id :concurrency,
   :rationale
   "Clojerl inherits BEAM's actor model: lightweight\n                    processes communicate by sending messages. Refs\n                    and agents do not map to that model. Atoms are\n                    implemented; deref/swap! semantics match\n                    Clojure (JVM)'s where the value is in-process.",
   :since "clojerl-0.1",
   :doc-link "https://www.erlang.org/doc/system/processes.html"}
  {:id :immutable-everything,
   :title "All values are immutable, including strings",
   :category-id :collections,
   :rationale
   "On the BEAM there are no mutable references that\n                    user code can observe. Strings are lists of\n                    integers or binaries; mutation operations from\n                    JVM-Clojure idioms (StringBuilder, transient!)\n                    have different shapes.",
   :since "clojerl-0.1"}
  {:id :numeric-tower-beam,
   :title "Numeric tower follows the BEAM, not the JVM",
   :category-id :numeric-tower,
   :rationale
   "Integers are arbitrary-precision (BEAM's\n                    `integer()`). Floats are IEEE-754 double.\n                    `bigint` is not a separate type. Ratios are not\n                    a built-in BEAM type.",
   :since "clojerl-0.1"}
  {:id :reader-conditional-clje,
   :title "Reader conditional :clj does not fire under Clojerl",
   :category-id :reader,
   :rationale
   "Clojerl uses :clje for its own branches. Code\n                    under :clj is not evaluated by Clojerl's\n                    reader.",
   :since "clojerl-0.1"}
  {:id :stdlib-partial,
   :title "Many Clojure (JVM) stdlib namespaces are not implemented",
   :category-id :namespaces,
   :rationale
   "Clojerl ships clojure.core, .string, .set, .walk,\n                    .test, .template. clojure.edn, .pprint, .math,\n                    .data, .zip, .datafy, .instant, .core.protocols,\n                    .core.reducers, .spec.alpha are not yet ported.",
   :since "clojerl-0.1"}
  {:id :pre-1-0-alpha,
   :title "Pre-1.0; behavior may change between releases",
   :category-id :namespaces,
   :rationale
   "Clojerl is pre-1.0. The current snapshot reflects\n                    what is implemented today; the divergence list\n                    will continue to evolve.",
   :since "clojerl-0.1"}],
