 [{:id :integer-radix-strings,
   :title "JVM static method mirrors for integer radix conversion",
   :affected-names
   ["clojure.core/Integer/toBinaryString"
    "clojure.core/Integer/toHexString"
    "clojure.core/Integer/toOctalString"
    "clojure.core/Long/toBinaryString"
    "clojure.core/Long/toHexString"
    "clojure.core/Long/toOctalString"],
   :category-id :jvm-statics,
   :rationale
   "Clojure code that calls Integer/toBinaryString\n                   etc. is fairly common; mino mirrors these as named\n                   bindings so portable code does not need to special-\n                   case mino. The implementation is in C, exposed via\n                   the jvm_statics module.",
   :since "v0.422.5"}
  {:id :bits-kw-match,
   :title "Keyword-based bitmask matching primitive",
   :affected-names ["clojure.core/bits-kw-match"],
   :category-id :collections,
   :rationale
   "Bit-level pattern matching against a keyword's\n                   internal representation. Designed for embedded use\n                   cases where bits-and-bytes ergonomics beat\n                   structural collection ops.",
   :since "v0.422.0"}
  {:id :time-ms-native,
   :title "Monotonic-clock primitive",
   :affected-names ["clojure.core/time-ms"],
   :category-id :jvm-statics,
   :rationale
   "mino-native replacement for (System/currentTimeMillis).\n                   Returns milliseconds since an implementation-defined\n                   epoch; suitable for measuring elapsed time within a\n                   single process.",
   :since "v0.166.0"}
  {:id :hpp-cpp-wrappers,
   :title "C++ RAII wrappers in mino.hpp",
   :affected-names ["clojure.core/cpp-wrappers"],
   :category-id :jvm-statics,
   :rationale
   "Optional C++ header (mino.hpp) gives embedders RAII\n                   semantics over mino_state lifecycle and value\n                   ownership. Not a Clojure-visible API; documented\n                   here to flag that mino's embedding surface extends\n                   beyond the C ABI.",
   :since "v0.421.0"}],
