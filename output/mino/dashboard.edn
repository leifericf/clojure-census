  {:id :reader-list-attaches-meta,
   :title "Reader attaches {:line :column} to lists only",
   :category-id :metadata,
   :rationale
   "mino mirrors JVM Clojure: per-cons reader meta is\n                    accessible through meta; literal vectors/maps/sets\n                    receive no per-instance reader meta.",
   :since "v0.422.0",
   :doc-link "/coming-from-clojure#metadata"}
  {:id :error-message-text-may-differ,
   :title "Error messages and ex-info keys may differ",
   :category-id :error-messages,
   :rationale
   "Exception text is implementation-defined in\n                    Clojure (JVM). mino's messages aim to be informative but\n                    are not byte-for-byte JVM-Clojure-compatible. Use\n                    ex-data / ex-cause / category keys to dispatch.",
   :since "v0.1.0"}
  {:id :no-clojure-repl,
   :title "clojure.repl is intentionally absent",
