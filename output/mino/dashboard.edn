{:meta
 {:dialect-tag "mino",
  :dialect-name "mino",
  :clojure-version "1.12.4",
  :compared-at "2026-06-07T06:31:49Z"},
 :divergences
 [{:dialect-example "(compare \"z\" \"a\") ;=> 1",
   :since "v0.1.0",
   :affected [clojure.core/compare],
   :clojure-example "(compare \"z\" \"a\") ;=> 25",
   :behavior
   {:expectation :diverges,
    :predicate :sign-normalized,
    :note
    "Same sign as JVM compare; magnitude\n                                  collapsed to -1/0/1."},
   :category-id :ordering,
   :title "compare returns sign-only (-1, 0, 1)",
   :doc-link "/coming-from-clojure#ordering",
   :rationale
   "Hickey-test for what compare's contract is: a\n                    three-way ordering function. Sign-normalized\n                    return values are simpler and avoid leaking\n                    representation-specific deltas.",
   :id :compare-sign-normalized}
  {:id :one-integer-tier,
   :title "Single integer type -- no Long/Integer/Short distinction",
   :category-id :numeric-tower,
   :rationale
   "mino has no JVM types; one integer representation\n                    suffices. Promotion within the integer tier never\n                    happens because there is only one tier.",
   :since "v0.1.0",
   :affected
   [clojure.core/integer? clojure.core/int? clojure.core/long]}
  {:id :double-float32-distinct,
   :title "Float-32 is a distinct numeric type",
   :category-id :numeric-tower,
   :rationale
   "mino exposes a 32-bit float-tagged value for\n                    space-constrained embedded use; Clojure (JVM) collapses\n                    to Double.",
   :since "v0.1.0",
   :doc-link "/coming-from-clojure#numeric"}
  {:dialect-example "(type [1 2 3]) ;=> :vector",
   :since "v0.1.0",
   :affected [clojure.core/type clojure.core/class],
   :clojure-example "(type [1 2 3]) ;=> clojure.lang.PersistentVector",
   :behavior
   {:expectation :diverges,
    :predicate :keyword-vs-class,
    :note
    "Oracle returns a Class object; mino\n                                  returns the analogous keyword tag."},
   :category-id :type-system,
   :title "type returns a keyword, not a Java class",
   :doc-link "/coming-from-clojure#types",
   :rationale
   "No JVM classes. mino's type system is keyword-\n                    tagged (:vector, :map, :list, :symbol, ...).\n                    Dispatch logic that pattern-matches on classes\n                    must use the keyword tags instead.",
   :id :type-as-keyword}
  {:id :class-of-non-jvm,
   :title "class behaves like type -- no JVM-class semantics",
   :category-id :type-system,
   :rationale
   "There are no classes; class is provided as a\n                    Clojure-shaped alias rather than a separate\n                    abstraction.",
   :since "v0.1.0",
   :affected
   [clojure.core/class clojure.core/class? clojure.core/instance?],
   :behavior
   {:expectation :diverges,
    :predicate :keyword-vs-class,
    :note
    "Same shape as :type-as-keyword for\n                                  the class accessor."}}
  {:id :ex-info-no-jvm-throwable-hierarchy,
   :title "ex-info / throw use mino-native exception type",
   :category-id :error-messages,
   :rationale
   "No JVM Throwable. mino's exception type is its\n                    own runtime value with :message and :data fields;\n                    instance checks via clojure.lang.ExceptionInfo do\n                    not work.",
   :since "v0.1.0",
   :affected
   [clojure.core/ex-info
    clojure.core/ex-data
    clojure.core/ex-message
    clojure.core/ex-cause],
   :behavior
   {:expectation :skip,
    :note
    "Exception type/message comparison is\n                                  out of scope per the README's\n                                  error-message exclusion."},
   :doc-link "/coming-from-clojure#exceptions"}
  {:id :no-jvm-class-statics,
   :title "Integer/MAX_VALUE etc. remapped or absent",
   :category-id :jvm-statics,
   :rationale
   "mino exposes a curated subset of JVM-static-name\n                    values (Integer/toBinaryString, Long/toHexString,\n                    ...) for Clojure code that depends on\n                    them. Most are absent.",
   :since "v0.1.0",
   :doc-link "/coming-from-clojure#jvm-statics"}
  {:id :concurrency-no-jvm-threads,
   :title "Atoms, refs, futures, agents have alpha-quality",
   :category-id :concurrency,
   :rationale
   "mino runs single-threaded in the embedded host;\n                    concurrency primitives are present but the\n                    underlying execution model is cooperative, not\n                    preemptive.",
   :since "v0.1.0",
   :affected
   [clojure.core/future
    clojure.core/agent
    clojure.core/send
    clojure.core/send-off],
   :doc-link "/coming-from-clojure#concurrency"}
  {:id :no-reader-conditional-clj,
   :title "Reader conditional :clj does not fire under mino",
   :category-id :reader,
   :rationale
   "mino is not JVM Clojure; portable code must use\n                    :default or :mino to target it. Documented and\n                    intentional.",
   :since "v0.1.0",
   :dialect-example "#?(:clj :A :mino :B :default :C) ;=> :B",
   :clojure-example "#?(:clj :A :mino :B :default :C) ;=> :A",
   :doc-link "/coming-from-clojure#reader-conditionals"}
  {:id :keyword-namespaces-canonicalized,
   :title "Namespaced keyword aliasing uses runtime aliases",
   :category-id :namespaces,
   :rationale
   "::alias/kw is resolved at read time against the\n                    current ns's aliases -- same as JVM Clojure, but\n                    mino's reader does not have access to the JVM\n                    classloader hierarchy.",
   :since "v0.1.0"}
  {:id :file-line-meta-source-aware,
   :title "Reader-tracked :file may be relative or absolute",
   :category-id :metadata,
   :rationale
   "mino's reader records the path as the embedder\n                    passed it; JVM Clojure normalizes to classpath-\n                    relative. Tools that compare :file values must\n                    accept either.",
   :since "v0.1.0"}
  {:id :pprint-minimal,
   :title "pprint is minimal -- no cl-format directives",
   :category-id :printer,
   :rationale
   "mino's clojure.pprint supports pretty-printing\n                    basic forms; cl-format and table directives are\n                    not implemented. Targets the common case.",
   :since "v0.1.0",
   :affected [clojure.pprint/cl-format clojure.pprint/print-table],
   :doc-link "/coming-from-clojure#pprint"}
  {:id :spec-gen-minimal,
   :title "clojure.spec generators ship as separate primitives",
   :category-id :collections,
   :rationale
   "mino's spec.alpha implements the documented\n                    surface; clojure.spec.gen.alpha is partially\n                    present and may diverge from clojure.test.check\n                    behavior on edge cases.",
   :since "v0.1.0",
   :doc-link "/coming-from-clojure#spec"}
  {:id :no-jvm-reflection,
   :title "No clojure.reflect -- JVM-only",
   :category-id :jvm-statics,
   :rationale
   "Reflection is meaningless without a JVM. mino's\n                    introspection uses ns-publics + meta, not class\n                    inspection.",
   :since "v0.1.0"}
  {:id :record-no-host-class,
   :title "defrecord types are not Java classes",
   :category-id :type-system,
   :rationale
   "mino's records carry identity, field slots, and a\n                    type keyword -- no host-level class is generated.\n                    instance? on a record uses the type keyword as\n                    its discriminator.",
   :since "v0.1.0",
   :affected [clojure.core/defrecord clojure.core/instance?]}
  {:id :proxy-not-implemented,
   :title "proxy is not provided",
   :category-id :jvm-statics,
   :rationale
   "proxy generates a JVM class -- no equivalent in\n                    mino. defrecord + protocols cover the same use\n                    case in a host-portable way.",
   :since "v0.1.0",
   :affected [clojure.core/proxy]}
  {:id :gen-class-not-implemented,
   :title "gen-class is not provided",
   :category-id :jvm-statics,
   :rationale
   "gen-class emits JVM bytecode. mino has no Java\n                    interop layer.",
   :since "v0.1.0",
   :affected [clojure.core/gen-class]}
  {:id :deftype-record-only,
   :title "deftype is an alias for defrecord without map-like ops",
   :category-id :type-system,
   :rationale
   "deftype's volatile-field and interface-impl\n                    features depend on JVM semantics. mino provides\n                    deftype as a structural type carrier; the JVM-\n                    only knobs are no-ops.",
   :since "v0.1.0",
   :affected [clojure.core/deftype]}
  {:id :transit-not-bundled,
   :title "transit reader/writer are not bundled",
   :category-id :collections,
   :rationale
   "Transit is a JVM artifact in Clojure (JVM) distributions;\n                    mino does not bundle it. EDN remains the wire\n                    format.",
   :since "v0.1.0"}
  {:id :clojure-java-io-absent,
   :title "clojure.java.io namespace is intentionally absent",
   :category-id :jvm-statics,
   :rationale
   "mino's host I/O is exposed via mino-native\n                    primitives that do not match File / InputStream\n                    abstractions. clojure.java.io is excluded from\n                    parity comparison.",
   :since "v0.1.0"}
  {:id :sorted-coll-comparator-default,
   :title "sorted-map default comparator does not handle mixed types",
   :category-id :ordering,
   :rationale
   "Cross-type comparison was closed in v0.98; mixed-\n                    type sorted-map keys without an explicit comparator\n                    may throw rather than coerce.",
   :since "v0.98.0",
   :affected [clojure.core/sorted-map clojure.core/sorted-set],
   :doc-link "/coming-from-clojure#ordering"}
  {:id :equality-default-strict,
   :title "= on cross-type numbers follows Clojure (JVM), not JVM =",
   :category-id :numeric-tower,
   :rationale
   "= remains a value-equality predicate; numeric\n                    equality across float / int is what Clojure (JVM)\n                    specifies, not JVM-Object-equality.",
   :since "v0.1.0",
   :affected [clojure.core/=]}
  {:id :iterate-chunking,
   :title "Sequence chunking is deterministic but not always 32",
   :category-id :collections,
   :rationale
   "Lazy realization batch size is implementation-\n                    defined in Clojure (JVM); mino picks sizes that suit the\n                    embedded use case. Code that depends on exact\n                    chunk boundaries is non-portable in Clojure (JVM) too.",
   :since "v0.1.0"}
  {:id :namespaced-map-default-true,
   :title "CLI default for *print-namespace-maps* is true",
   :category-id :printer,
   :rationale
   "mino's CLI alters the var-root to true on startup\n                    so user-facing prints collapse qualified-key maps.\n                    bb and JVM Clojure do the same; library use sees\n                    the documented false default.",
   :since "v0.422.0",
   :affected [clojure.core/*print-namespace-maps*]}
  {:id :reader-list-attaches-meta,
   :title "Reader attaches {:line :column} to lists only",
   :category-id :metadata,
   :rationale
   "mino mirrors JVM Clojure: per-cons reader meta is\n                    accessible through meta; literal vectors/maps/sets\n                    receive no per-instance reader meta.",
   :since "v0.422.0",
   :doc-link "/coming-from-clojure#metadata"}
  {:id :error-message-text-may-differ,
   :title "Error messages and ex-info keys may differ",
   :category-id :error-messages,
   :rationale
   "Exception text is implementation-defined in\n                    Clojure (JVM). mino's messages aim to be informative but\n                    are not byte-for-byte JVM-Clojure-compatible. Use\n                    ex-data / ex-cause / category keys to dispatch.",
   :since "v0.1.0"}
  {:id :clojure-test-machinery-mino-shape,
   :title
   "clojure.test reports via mino's counters, not JVM clojure.test/report",
   :category-id :error-messages,
   :rationale
   "Per-assertion error isolation matches Clojure (JVM)'s\n                    contract. The underlying report mechanism uses\n                    mino-native counters and prints rather than the\n                    JVM clojure.test/report multimethod.",
   :since "v0.422.0",
   :affected [clojure.test/report clojure.test/run-tests]}
  {:id :no-clojure-repl,
   :title "clojure.repl is intentionally absent",
   :category-id :jvm-statics,
   :rationale
   "Repl support is environment-bound and uses\n                    embedder-specific input/output. doc, source,\n                    apropos are exposed at the CLI rather than in\n                    a namespace.",
   :since "v0.1.0"}],
