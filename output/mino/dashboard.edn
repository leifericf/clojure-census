   :affected [clojure.pprint/cl-format clojure.pprint/print-table],
   :doc-link "/coming-from-clojure#pprint"}
  {:id :spec-gen-minimal,
   :title "clojure.spec generators ship as separate primitives",
   :category-id :collections,
   :rationale
