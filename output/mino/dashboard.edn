   :affected [clojure.core/defrecord clojure.core/instance?]}
  {:id :proxy-not-implemented,
   :title "proxy is not provided",
   :category-id :jvm-statics,
   :rationale
   "proxy generates a JVM class -- no equivalent in\n                    mino. defrecord + protocols cover the same use\n                    case in a host-portable way.",
   :since "v0.1.0",
   :affected [clojure.core/proxy]}
  {:id :gen-class-not-implemented,
   :title "gen-class is not provided",
   :category-id :jvm-statics,
   :rationale
