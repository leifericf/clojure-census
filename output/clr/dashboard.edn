{:meta
 {:dialect-tag "clr",
  :dialect-name "ClojureCLR",
  :clojure-version "1.12.4",
  :compared-at "2026-08-28T17:43:49Z"},
 :divergences
 [{:id :host-class-system-clr,
   :title "Host classes are CLR System.*, not JVM java.*",
   :category-id :type-system,
   :rationale
   "`(class x)` returns a CLR Type object. Code that\n                    pattern-matches on `java.lang.Long` or similar\n                    names doesn't work; CLR equivalents are\n                    `System.Int64`, `System.String`, etc.",
   :since "clr-1.0",
   :affected
   [clojure.core/class clojure.core/type clojure.core/instance?],
   :doc-link "https://github.com/clojure/clojure-clr"}
  {:id :env-via-system-environment,
   :title "Environment variables read via System.Environment",
   :category-id :jvm-statics,
   :rationale
   "`System/getenv` doesn't exist on CLR; the\n                    equivalent is\n                    `System.Environment/GetEnvironmentVariable`.\n                    Portable code uses a host-conditional helper.",
   :since "clr-1.0"}
  {:id :no-java-io-namespace,
   :title "clojure.java.io is intentionally absent",
   :category-id :jvm-statics,
   :rationale
   "CLR's IO abstractions are System.IO.*; a separate\n                    ClojureCLR-side namespace `clojure.clr.io` covers\n                    the equivalent surface. Code that requires\n                    `clojure.java.io` is JVM-bound.",
   :since "clr-1.0",
   :affected [clojure.core/spit clojure.core/slurp]}
  {:id :no-proxy-on-clr-same-shape,
   :title "proxy targets CLR types, not JVM interfaces",
   :category-id :jvm-statics,
   :rationale
   "`proxy` is supported on CLR but emits CLR types\n                    extending CLR base classes. Proxies of JVM-only\n                    interfaces (Runnable, Callable) do not translate.",
   :since "clr-1.0",
   :affected [clojure.core/proxy]}
  {:id :gen-class-targets-clr-msil,
   :title "gen-class emits CLR MSIL, not JVM bytecode",
   :category-id :jvm-statics,
   :rationale
   "`gen-class` works on CLR but the AOT artifact is\n                    a .NET assembly, not a .class file. Consumers\n                    that load the generated class via JVM tooling do\n                    not work.",
   :since "clr-1.0",
   :affected [clojure.core/gen-class]}
  {:id :exception-type-from-system,
   :title "Throwables are System.Exception, not java.lang.Throwable",
   :category-id :error-messages,
   :rationale
   "`(catch Throwable e ...)` is not portable to CLR;\n                    catch `Exception` instead. Portable code uses\n                    `:cljr` reader conditionals around catch targets.",
   :since "clr-1.0"}
  {:id :reader-conditional-cljr,
   :title "Reader conditional :clj does not fire under CLR",
   :category-id :reader,
   :rationale
   "Portable code uses :cljr (or :default) to target\n                    ClojureCLR. Code under :clj is invisible to CLR's\n                    reader.",
   :since "clr-1.0"}
  {:id :concurrency-cli-thread-model,
   :title "Concurrency primitives use CLR thread pool",
   :category-id :concurrency,
   :rationale
   "Atom / future / agent are implemented on top of\n                    System.Threading, not java.util.concurrent. The\n                    semantics match Clojure (JVM); the underlying threads\n                    differ if interop'd with.",
   :since "clr-1.0"}],
