  :clojure-version "1.12.4",
  :compared-at "2026-09-02T09:34:53Z"},
 :divergences
 [{:id :reducers-absent,
   :title "clojure.core.reducers is not bundled",
   :category-id :collections,
   :rationale
   "bb omits the reducers namespace -- fold/r/map etc.\n                    are not available. Transducers cover the typical\n                    use cases.",
   :since "bb-1.0",
   :affected
   [clojure.core.reducers/fold
    clojure.core.reducers/reduce
    clojure.core.reducers/map],
   :doc-link "https://book.babashka.org/#differences_with_clojure"}
  {:id :proxy-not-supported,
   :title "proxy emits no JVM class",
   :category-id :jvm-statics,
   :rationale
   "proxy generates a JVM class at runtime; SCI has no\n                    bytecode emitter. defrecord + protocols cover the\n                    portable use case.",
   :since "bb-1.0",
   :affected [clojure.core/proxy]}
  {:id :gen-class-not-supported,
   :title "gen-class is not supported",
   :category-id :jvm-statics,
   :rationale
   "gen-class emits AOT JVM bytecode. SCI interprets;\n                    there is no class to emit.",
   :since "bb-1.0",
   :affected [clojure.core/gen-class]}
  {:id :reflection-not-portable,
   :title "clojure.reflect is not bundled",
   :category-id :jvm-statics,
   :rationale
   "JVM reflection is available via clojure.core/bean\n                    and member-access, but the clojure.reflect\n                    namespace is omitted from bb's bundle.",
   :since "bb-1.0"}
  {:id :sci-eval-semantics,
   :title "eval / load-string interpret via SCI, not Compiler",
   :category-id :macros,
   :rationale
   "Macroexpansion semantics generally match Clojure (JVM)\n                    but the underlying interpreter is SCI, so certain\n                    macro hygiene edge cases that rely on the Clojure\n                    Compiler's specific behavior may differ.",
   :since "bb-1.0",
   :affected [clojure.core/eval clojure.core/load-string]}
  {:id :startup-no-classloader-trickery,
   :title "No classpath-time loading of user-supplied .class files",
   :category-id :jvm-statics,
   :rationale
   "bb is a self-contained binary; the JVM\n                    classloader / classpath model that Clojure (JVM) code can\n                    poke at (clojure.lang.RT/baseLoader, etc.) is\n                    not exposed.",
   :since "bb-1.0"}],
