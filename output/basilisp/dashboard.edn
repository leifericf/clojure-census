 :divergences
 [{:id :python-host,
   :title "Host runtime is Python 3, not the JVM",
   :category-id :jvm-statics,
   :rationale
   "Interop targets Python objects, not java.lang.*.\n                    JVM-static names (System/getenv, Math/PI,\n                    Integer/parseInt) do not resolve; equivalents\n                    are reached via Python interop (operator,\n                    os.environ, math).",
   :since "basilisp-0.1",
   :doc-link "https://basilisp.readthedocs.io/"}
  {:id :concurrency-gil,
   :title "Python's GIL constrains threaded concurrency",
   :category-id :concurrency,
   :rationale
   "Atoms, refs, and agents work, but CPython's\n                    Global Interpreter Lock serializes bytecode\n                    execution. Threaded throughput differs from\n                    JVM Clojure in both absolute speed and the\n                    granularity of fairness.",
   :since "basilisp-0.1"}
  {:id :numeric-model,
   :title "Numeric tower follows Python, not JVM Clojure",
   :category-id :numeric-tower,
   :rationale
   "Integers are arbitrary-precision by default\n                    (Python's int). Float is IEEE-754 double, as on\n                    the JVM. Ratio is implemented as\n                    fractions.Fraction. Overflow semantics on auto-\n                    promoted ops match Python's rules, not the\n                    JVM's Long boxing model.",
   :since "basilisp-0.1"}
  {:id :exception-types,
   :title "Exceptions are Python exceptions",
   :category-id :error-messages,
   :rationale
   "(catch Exception e ...) catches a Python\n                    Exception, not a java.lang.Exception. Code that\n                    catches specific JVM exception classes (e.g.\n                    java.io.IOException) must use Python-host\n                    equivalents (OSError) under a :lpy reader\n                    conditional.",
   :since "basilisp-0.1"}
  {:id :stdlib-partial,
   :title
   "Several Clojure (JVM) stdlib namespaces are not implemented",
   :category-id :namespaces,
   :rationale
   "Basilisp ships clojure.core, .string, .set, .walk,\n                    .test, .template; coverage of .edn, .pprint, .data,\n                    .zip, .math, .datafy, .instant, .core.protocols,\n                    .core.reducers, and .spec.alpha varies by release.\n                    Refer to upstream release notes for the current\n                    state.",
   :since "basilisp-0.1",
   :doc-link
   "https://basilisp.readthedocs.io/en/latest/differencesfromclojure.html"}
  {:id :reader-conditional-lpy,
   :title "Reader conditional :clj does not fire under Basilisp",
   :category-id :reader,
   :rationale
   "Basilisp uses the :lpy feature for its own\n                    branches. Code under :clj is not evaluated by\n                    Basilisp's reader.",
   :since "basilisp-0.1",
   :doc-link
   "https://basilisp.readthedocs.io/en/latest/concepts.html#reader-conditionals"}],
