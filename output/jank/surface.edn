    bit-clear {:arglists ([x n]), :doc "Clear bit at index n"},
    bit-flip {:arglists ([x n]), :doc "Flip bit at index n"},
    bit-not {:arglists ([x]), :doc "Bitwise complement"},
    bit-or {:arglists ([x y] [x y & more]), :doc "Bitwise or"},
    bit-set {:arglists ([x n]), :doc "Set bit at index n"},
    bit-shift-left {:arglists ([x n]), :doc "Bitwise shift left"},
    bit-shift-right {:arglists ([x n]), :doc "Bitwise shift right"},
    bit-test {:arglists ([x n]), :doc "Test bit at index n"},
    bit-xor
    {:arglists ([x y] [x y & more]), :doc "Bitwise exclusive or"},
    boolean {:arglists ([x]), :doc "Coerce to boolean"},
    boolean-array
    {:arglists ([size-or-seq] [size init-val-or-seq]),
     :doc "Creates an array of booleans"},
    boolean? {:arglists ([x]), :doc "Returns true if x is a boolean"},
    bound-fn
