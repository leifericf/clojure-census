     :doc
     "Sets the value at the index/indices. Works on arrays of float. Returns val."},
    aset-int
    {:arglists ([array idx val] [array idx idx2 & idxv]),
     :doc
     "Sets the value at the index/indices. Works on arrays of int. Returns val."},
    aset-long
    {:arglists ([array idx val] [array idx idx2 & idxv]),
