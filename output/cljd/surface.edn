{:dialect-tag "cljd",
 :clojure-version "4cdb4be-cljd",
 :namespaces
 {clojure.core
  {:vars
   {* {:arglists ([] [x] [x y] [x y & more])},
    *1 {:dynamic true},
    *2 {:dynamic true},
    *3 {:dynamic true},
    *async-error-handler*
    {:doc
     "nil or unction of two arguments: exception and stack trace.\n   When not nil, will be called whenever an async operation initiated\n   under this binding throws an uncaught exception.",
     :dynamic true},
    *data-readers*
    {:doc
     "Map from reader tag symbols to data reader Vars.\n\n  When Clojure starts, it searches for files named 'data_readers.clj'\n  and 'data_readers.cljc' at the root of the classpath. Each such file\n  must contain a literal map of symbols, like this:\n\n      {foo/bar my.project.foo/bar\n       foo/baz my.project/baz}\n\n  The first symbol in each pair is a tag that will be recognized by\n  the Clojure reader. The second symbol in the pair is the\n  fully-qualified name of a Var which will be invoked by the reader to\n  parse the form following the tag. For example, given the\n  data_readers.clj file above, the Clojure reader would parse this\n  form:\n\n      #foo/bar [1 2 3]\n\n  by invoking the Var #'my.project.foo/bar on the vector [1 2 3]. The\n  data reader function is invoked on the form AFTER it has been read\n  as a normal Clojure data structure by the reader.\n\n  Reader tags without namespace qualifiers are reserved for\n  Clojure. Default reader tags are defined in\n  clojure.core/default-data-readers but may be overridden in\n  data_readers.clj, data_readers.cljc, or by rebinding this Var.",
     :dynamic true},
    *default-data-reader-fn*
    {:doc
     "When no data reader is found for a tag and *default-data-reader-fn*\n  is non-nil, it will be called with two arguments,\n  the tag and the value.  If *default-data-reader-fn* is nil (the\n  default), an exception will be thrown for the unknown tag.",
     :dynamic true},
    *e {:dynamic true},
    *env {:dynamic true},
    *err* {:dynamic true},
    *exec-tap-fn*
    {:doc
     "Arranges to have tap functions executed via the supplied f, a\n  function of no arguments. Returns true if successful, false otherwise.",
     :dynamic true,
     :arglists ([f])},
    *ns* {:dynamic true},
    *out* {:dynamic true},
    *print-dup* {:dynamic true},
    *print-length*
    {:doc
     "*print-length* controls how many items of each collection the\n  printer will print. If it is bound to logical false, there is no\n  limit. Otherwise, it must be bound to an integer indicating the maximum\n  number of items of each collection to print. If a collection contains\n  more items, the printer will print items up to the limit followed by\n  '...' to represent the remaining items. The root binding is nil\n  indicating no limit.",
     :dynamic true},
    *print-level*
    {:doc
     "*print-level* controls how many levels deep the printer will\n  print nested objects. If it is bound to logical false, there is no\n  limit. Otherwise, it must be bound to an integer indicating the maximum\n  level to print. Each argument to print is at level 0; if an argument is a\n  collection, its items are at level 1; and so on. If an object is a\n  collection and is at a level greater than or equal to the value bound to\n  *print-level*, the printer prints '#' to represent it. The root binding\n  is nil indicating no limit.",
     :dynamic true},
    *print-meta* {:dynamic true},
    *print-readably* {:dynamic true},
    *st {:dynamic true},
    + {:arglists ([] [x] [x y] [x y & more])},
    - {:arglists ([x] [x y] [x y & more])},
    ->
    {:doc
     "Threads the expr through the forms. Inserts x as the\n  second item in the first form, making a list of it if it is not a\n  list already. If there are more forms, inserts the first form as the\n  second item in second form, etc.",
     :macro true,
     :arglists ([x & forms])},
    ->>
    {:doc
     "Threads the expr through the forms. Inserts x as the\n  last item in the first form, making a list of it if it is not a\n  list already. If there are more forms, inserts the first form as the\n  last item in second form, etc.",
     :macro true,
     :arglists ([x & forms])},
    -EMPTY-BITMAP-NODE {},
    -EMPTY-LIST {},
    -EMPTY-MAP {},
    -EMPTY-SET {},
    -EMPTY-VECTOR {},
    -async-error-handler-zone-spec {},
    -empty-treap-node {},
    -equiv-map
    {:doc
     "Test map equivalence. Returns true if x equals y, otherwise returns false.",
     :arglists ([x y])},
    -equiv-sequential
    {:doc "Assumes x is sequential.", :arglists ([x y])},
    -has-stable-hash? {:macro true, :arglists ([x])},
    -hash-string-cache {},
    -list-lit {:arglists ([xs])},
    -map-lit {:macro true, :arglists ([quoted m])},
    -mk-multimethod {:arglists ([mm-name dispatch table default])},
    -print-map {:arglists ([m sink])},
    -print-sequential {:arglists ([begin end sequence sink])},
    -set-lit {:macro true, :arglists ([quoted s])},
    -vec-lit {:macro true, :arglists ([quoted v])},
    / {:arglists ([x] [x y] [x y & more])},
    < {:arglists ([x] [x y] [x y & more])},
    <= {:arglists ([x] [x y] [x y & more])},
    = {:arglists ([x] [x y] [x y & more])},
    == {:arglists ([x] [x y] [x y & more])},
    => {:macro true, :arglists ([a b])},
    > {:arglists ([x] [x y] [x y & more])},
    >0? {:macro true, :arglists ([n])},
    >1? {:macro true, :arglists ([n])},
    >= {:arglists ([x] [x y] [x y & more])},
    NaN?
    {:doc "Returns true if num is NaN, else false",
     :added "1.11",
     :arglists ([num])},
    RNG {},
    abs {:doc "Returns the absolute value of a.", :arglists ([a])},
    aclone {:arglists ([arr])},
    add-tap
    {:doc
     "Adds f, a fn of one argument, to the tap set. This function will be called with\n  anything sent via tap>. Remember f in order to remove-tap",
     :arglists ([f])},
    add-watch
    {:doc
     "Adds a watch function to an atom reference. The watch fn must be a\n  fn of 4 args: a key, the reference, its old-state, its\n  new-state. Whenever the reference's state might have been changed,\n  any registered watches will have their functions called. The watch\n  fn will be called synchronously. Note that an atom's state\n  may have changed again prior to the fn call, so use old/new-state\n  rather than derefing the reference. Keys must be unique per\n  reference, and can be used to remove the watch with remove-watch,\n  but are otherwise considered opaque by the watch mechanism.  Bear in\n  mind that regardless of the result or action of the watch fns the\n  atom's value will change.  Example:\n\n      (def a (atom 0))\n      (add-watch a :inc (fn [k r o n] (assert (== 0 n))))\n      (swap! a inc)\n      ;; Assertion Error\n      (deref a)\n      ;=> 1",
     :arglists ([reference key fn])},
    aget
    {:doc
     "Returns the value at the index/indices. Works on Java arrays of all\n  types.",
     :arglists ([array idx] [array idx & idxs])},
    alength {:arglists ([array])},
    alter-meta!
    {:doc
     "Atomically sets the metadata for a atom to be:\n\n  (apply f its-current-meta args)\n\n  f must be free of side-effects",
     :arglists ([atom f & args])},
    amap
    {:doc
     "Maps an expression across an array a, using an index named idx, and\n  return value named ret, initialized to a clone of a, then setting\n  each element of ret to the evaluation of expr, returning the new\n  array ret.",
     :macro true,
     :arglists ([a idx ret expr])},
    and
    {:doc
     "Evaluates exprs one at a time, from left to right. If a form\n  returns logical false (nil or false), and returns that value and\n  doesn't evaluate any of the other expressions, otherwise it returns\n  the value of the last expr. (and) returns true.",
     :added "1.0",
     :macro true,
     :arglists ([] [x] [x & next])},
    any? {:doc "Returns true given any argument.", :arglists ([x])},
    apply
    {:arglists
     ([f args]
      [f x args]
      [f x y args]
      [f x y z args]
      [f a b c d & args])},
    areduce
    {:doc
     "Reduces an expression across an array a, using an index named idx,\n  and return value named ret, initialized to init, setting ret to the\n  evaluation of expr at each step, returning ret.",
     :macro true,
     :arglists ([a idx ret init expr])},
    aresize {:arglists ([a from to pad])},
    argument-error {:macro true},
    as->
    {:doc
     "Binds name to expr, evaluates the first form in the lexical context\n  of that binding, then binds name to that result, repeating for each\n  successive form, returning the result of the last form.",
     :macro true,
     :arglists ([expr name & forms])},
    aset
    {:doc
     "Sets the value at the index/indices. Works on Java arrays of\n  reference types. Returns val.",
     :arglists ([array idx val] [array idx idx2 & idxv])},
    ashrink {:arglists ([a to])},
    assert
    {:doc
     "Evaluates expr and throws an exception if it does not evaluate to\n  logical true.",
     :macro true,
     :arglists ([x] [x message])},
    assert-bitmap-node
    {:arglists ([{:flds [cnt bitmap_hi bitmap_lo arr], :as node}])},
    assoc {:arglists ([map key val] [map key val & kvs])},
    assoc!
    {:doc
     "When applied to a transient map, adds mapping of key(s) to\n  val(s). When applied to a transient vector, sets the val at index.\n  Note - index must be <= (count vector). Returns coll.",
     :arglists ([coll key val] [coll key val & kvs])},
    assoc-in
    {:doc
     "Associates a value in a nested associative structure, where ks is a\n  sequence of keys and v is the new value and returns a new nested structure.\n  If any levels do not exist, hash-maps will be created.",
     :arglists ([m [k & ks] v])},
    associative?
    {:doc "Returns true if coll implements Associative",
     :arglists ([x])},
    atom {:arglists ([x] [x & {:keys [meta validator], :as o}])},
    await {:macro true, :arglists ([expr])},
    binding
    {:doc
     "binding => var-symbol init-expr\n\n  Creates new bindings for the (already-existing) vars, with the\n  supplied initial values, executes the exprs in an implicit do, then\n  re-establishes the bindings that existed before.  The new bindings\n  are made in parallel (unlike let); all init-exprs are evaluated\n  before the vars are bound to their new values.",
     :macro true,
     :arglists ([bindings & body])},
    bit-and {:doc "Bitwise and", :arglists ([x y] [x y & more])},
    bit-and-not
    {:doc "Bitwise and with complement",
     :arglists ([x y] [x y & more])},
    bit-clear {:doc "Clear bit at index n", :arglists ([x n])},
    bit-flip {:doc "Flip bit at index n", :arglists ([x n])},
    bit-not {:doc "Bitwise complement", :arglists ([x])},
    bit-or {:doc "Bitwise or", :arglists ([x y] [x y & more])},
    bit-set {:doc "Set bit at index n", :arglists ([x n])},
    bit-shift-left {:doc "Bitwise shift left", :arglists ([x n])},
    bit-shift-right {:arglists ([x n])},
    bit-test {:doc "Test bit at index n", :arglists ([x n])},
    bit-xor
    {:doc "Bitwise exclusive or", :arglists ([x y] [x y & more])},
    boolean {:doc "Coerce to boolean", :arglists ([x])},
    boolean? {:doc "Return true if x is a Boolean", :arglists ([x])},
    booleans {:doc "Casts to List<bool>", :arglists ([xs])},
    bounded-count
    {:doc
     "If coll is counted? returns its count, else will count at most the first n\n  elements of coll using its seq",
     :arglists ([n coll])},
    butlast
    {:doc
     "Return a seq of all but the last item in coll, in linear time",
     :arglists ([s])},
    call-to {:macro true, :arglists ([f])},
    case {:macro true, :arglists ([expr & clauses])},
    cat
    {:doc
     "A transducer which concatenates the contents of each input, which must be a\n  collection, into the reduction.",
     :arglists ([rf])},
    char {:doc "Coerce to single character string.", :arglists ([x])},
    char?
    {:doc "Returns true if x is a Dart string of length one.",
     :arglists ([x])},
    chunk {:arglists ([b])},
    chunk-append {:arglists ([b x])},
    chunk-buffer {:arglists ([capacity])},
    chunk-cons {:arglists ([chunk rest])},
    chunk-first {:arglists ([s])},
    chunk-next {:arglists ([s])},
    chunk-reduce {:arglists ([f val coll])},
    chunk-rest {:arglists ([s])},
    chunked-iterator-seq {:arglists ([iter] [iter chunk-size])},
    chunked-seq?
    {:doc "Return true if x satisfies IChunkedSeq.", :arglists ([x])},
    coll?
    {:doc "Returns true if x satisfies ICollection", :arglists ([x])},
    comment
    {:doc "Ignores body, yields nil",
     :added "1.0",
     :macro true,
     :arglists ([& body])},
    comp
    {:doc
     "Takes a set of functions and returns a fn that is the composition\n  of those fns.  The returned fn takes a variable number of args,\n  applies the rightmost of fns to the args, the next\n  fn (right-to-left) to the result, etc.",
     :arglists ([] [f] [f g] [f g & fs])},
    compare {:arglists ([x y])},
    compare-and-set!
    {:doc
     "Atomically sets the value of atom to newval if and only if the\n  current value of the atom is equal to oldval. Returns true if\n  set happened, else false.",
     :arglists ([a oldval newval])},
    compare-indexed
    {:doc "Used as foundation for indexed DS as comparator function.",
     :arglists ([x y])},
    complement
    {:doc
     "Takes a fn f and returns a fn that takes the same arguments as f,\n  has the same effects, if any, and returns the opposite truth value.",
     :arglists ([f])},
    completing
    {:doc
     "Takes a reducing function f of 2 args and returns a fn suitable for\n  transduce by adding an arity-1 signature that calls cf (default -\n  identity) on the result argument.",
     :arglists ([f] [f cf])},
    concat
    {:doc
     "Returns a lazy seq representing the concatenation of the elements in the supplied colls.",
     :arglists ([] [x] [x y] [x y & zs])},
    cond
    {:doc
     "Takes a set of test/expr pairs. It evaluates each test one at a\n  time.  If a test returns logical true, cond evaluates and returns\n  the value of the corresponding expr and doesn't evaluate any of the\n  other tests or exprs. (cond) returns nil.",
     :added "1.0",
     :macro true,
     :arglists ([& clauses])},
    cond->
    {:doc
     "Takes an expression and a set of test/form pairs. Threads expr (via ->)\n  through each form for which the corresponding test\n  expression is true. Note that, unlike cond branching, cond-> threading does\n  not short circuit after the first true test expression.",
     :macro true,
     :arglists ([expr & clauses])},
    cond->>
    {:doc
     "Takes an expression and a set of test/form pairs. Threads expr (via ->>)\n  through each form for which the corresponding test expression\n  is true.  Note that, unlike cond branching, cond->> threading does not short circuit\n  after the first true test expression.",
     :macro true,
     :arglists ([expr & clauses])},
    condp
    {:doc
     "Takes a binary predicate, an expression, and a set of clauses.\n  Each clause can take the form of either:\n\n  test-expr result-expr\n\n  test-expr :>> result-fn\n\n  Note :>> is an ordinary keyword.\n\n  For each clause, (pred test-expr expr) is evaluated. If it returns\n  logical true, the clause is a match. If a binary clause matches, the\n  result-expr is returned, if a ternary clause matches, its result-fn,\n  which must be a unary function, is called with the result of the\n  predicate as its argument, the result of that call being the return\n  value of condp. A single default expression can follow the clauses,\n  and its value will be returned if no clause matches. If no default\n  expression is provided and no clause matches, an\n  IllegalArgumentException is thrown.",
     :macro true,
     :arglists ([pred expr & clauses])},
    conj
    {:doc
     "conj[oin]. Returns a new collection with the xs\n    'added'. (conj nil item) returns (item).  The 'addition' may\n    happen at different 'places' depending on the concrete type.",
     :arglists ([] [coll] [coll x] [coll x & xs])},
    conj!
    {:doc
     "Adds x to the transient collection, and return coll. The 'addition'\n  may happen at different 'places' depending on the concrete type.",
     :arglists ([] [coll] [coll x])},
    cons
    {:doc
     "Returns a new seq where x is the first element and coll is the rest.",
     :arglists ([x coll])},
    constantly
    {:doc
     "Returns a function that takes any number of arguments and returns x.",
     :arglists ([x])},
    contains?
    {:doc
     "Returns true if key is present in the given collection, otherwise\n  returns false.  Note that for numerically indexed collections like\n  vectors and Dart lists, this tests if the numeric key is within the\n  range of indexes. 'contains?' operates constant or logarithmic time;\n  it will not perform a linear search for a value.  See also 'some'.",
     :arglists ([coll key])},
    count {:arglists ([coll])},
    counted?
    {:doc "Returns true if coll implements count in constant time.",
     :arglists ([coll])},
    cycle
    {:doc
     "Returns a lazy (infinite!) sequence of repetitions of the items in coll.",
     :arglists ([coll])},
    dart-comparator
    {:doc
     "Takes a fn that might be boolean valued or a comparator,\n   returns a dart:core/Comparator.",
     :arglists ([f])},
    dec {:arglists ([x])},
    declare
    {:doc
     "defs the supplied var names with no bindings, useful for making forward declarations.",
     :macro true,
     :arglists ([& names])},
    dedupe
    {:doc
     "Returns a lazy sequence removing consecutive duplicates in coll.\n  Returns a transducer when no collection is provided.",
     :arglists ([] [coll])},
    def-list-for-type
    {:macro true,
     :arglists ([fn-name doc-str class-name default-value])},
    default-data-readers
    {:doc
     "Default map of data reader functions provided by Clojure. May be\n  overridden by binding *data-readers*."},
    definterface {:macro true, :arglists ([iface & meths])},
    defmacro
    {:doc
     "Like defn, but the resulting function name is declared as a\n  macro and will be used as a macro by the compiler when it is\n  called.",
     :added "1.0",
     :macro true},
    defn
    {:doc
     "Same as (def name (fn [params* ] exprs*)) or (def\n    name (fn ([params* ] exprs*)+)) with any doc-string or attrs added\n    to the var metadata. prepost-map defines a map with optional keys\n    :pre and :post that contain collections of pre or post conditions.",
     :macro true},
    defn-
    {:doc "same as defn, yielding non-public def",
     :macro true,
     :arglists ([name & decls])},
    defonce
    {:doc
     "defs name to have the root value of the expr iff the named var has no root value,\n  else expr is unevaluated",
     :macro true,
     :arglists ([name expr])},
    defrecord {:macro true, :arglists ([name fields & opts+specs])},
    deftype {:macro true, :arglists ([& args])},
    delay {:macro true, :arglists ([& body])},
    delay?
    {:doc "returns true if x is a Delay created with delay",
     :arglists ([x])},
    deref
    {:doc
     "Also reader macro: @ref/@agent/@var/@atom/@delay/@future/@promise. Within a transaction,\n  returns the in-transaction-value of ref, else returns the\n  most-recently-committed value of ref. When applied to a var, agent\n  or atom, returns its current state. When applied to a delay, forces\n  it if not already forced. When applied to a future, will block if\n  computation not complete. When applied to a promise, will block\n  until a value is delivered.  The variant taking a timeout can be\n  used for blocking references (futures and promises), and will return\n  timeout-val if the timeout (in milliseconds) is reached before a\n  value is available. See also - realized?.",
     :arglists ([ref])},
    destructure {:macro true, :arglists ([bindings])},
    disj
    {:doc
     "disj[oin]. Returns a new set of the same (hashed/sorted) type, that\n  does not contain key(s).",
     :arglists ([set] [set key] [set key & ks])},
    disj!
    {:doc
     "disj[oin]. Returns a transient set of the same (hashed/sorted) type, that\n  does not contain key(s).",
     :arglists ([set] [set key] [set key & ks])},
    dissoc
    {:doc
     "dissoc[iate]. Returns a new map of the same (hashed/sorted) type,\n  that does not contain a mapping for key(s).",
     :arglists ([map] [map key] [map key & ks])},
    dissoc!
    {:doc
     "Returns a transient map that doesn't contain a mapping for key(s).",
     :arglists ([tcoll key] [tcoll key & ks])},
    distinct
    {:doc
     "Returns a lazy sequence of the elements of coll with duplicates removed.\n  Returns a stateful transducer when no collection is provided.",
     :arglists ([] [coll])},
    distinct?
    {:doc "Returns true if no two of the arguments are =",
     :arglists ([x] [x y] [x y & more])},
    do-assoc {:arglists ([level node n val])},
    doall
    {:doc
     "When lazy sequences are produced via functions that have side\n  effects, any effects other than those needed to produce the first\n  element in the seq do not occur until the seq is consumed. doall can\n  be used to force any effects. Walks through the successive nexts of\n  the seq, retains the head and returns it, thus causing the entire\n  seq to reside in memory at one time.",
     :arglists ([coll] [n coll])},
    dorun
    {:doc
     "When lazy sequences are produced via functions that have side\n  effects, any effects other than those needed to produce the first\n  element in the seq do not occur until the seq is consumed. dorun can\n  be used to force any effects. Walks through the successive nexts of\n  the seq, does not retain the head and returns nil.",
     :arglists ([coll] [n coll])},
    doseq
    {:doc
     "Repeatedly executes body (presumably for side-effects) with\n  bindings and filtering as provided by \"for\".  Does not retain\n  the head of the sequence. Returns nil.",
     :macro true,
     :arglists ([seq-exprs & body-expr])},
    dotimes
    {:doc
     "bindings => name n\n\n  Repeatedly executes body (presumably for side-effects) with name\n  bound to integers from 0 through n-1.",
     :macro true,
     :arglists ([bindings & body])},
    doto
    {:doc
     "Evaluates x then calls all of the methods and functions with the\n  value of x supplied at the front of the given arguments.  The forms\n  are evaluated in order.  Returns x.",
     :macro true,
     :arglists ([x & forms])},
    double {:doc "Coerce to double", :arglists ([x])},
    double? {:doc "Return true if x is a Double", :arglists ([x])},
    doubles {:doc "Casts to List<double>", :arglists ([xs])},
    drop
    {:doc
     "Returns a lazy sequence of all but the first n items in coll.\n  Returns a stateful transducer when no collection is provided.",
     :arglists ([n] [n coll])},
    drop-last
    {:doc
     "Return a lazy sequence of all but the last n (default 1) items in coll",
     :arglists ([coll] [n coll])},
    drop-while
    {:doc
     "Returns a lazy sequence of the items in coll starting from the\n  first item for which (pred item) returns logical false.  Returns a\n  stateful transducer when no collection is provided.",
     :arglists ([pred] [pred coll])},
    eduction
    {:doc
     "Returns a reducible/iterable application of the transducers\n  to the items in coll. Transducers are applied in order as if\n  combined with comp. Note that these applications will be\n  performed every time reduce/iterator is called.",
     :arglists ([& xforms])},
    empty
    {:doc
     "Returns an empty collection of the same category as coll, or nil",
     :arglists ([coll])},
    empty?
    {:doc
     "Returns true if coll has no items - same as (not (seq coll)).\n  Please use the idiom (seq x) rather than (not (empty? x))",
     :arglists ([coll])},
    ensure-hash {:macro true, :arglists ([hash-key hash-expr])},
    ensure-reduced
    {:doc
     "If x is already reduced?, returns it, else returns (reduced x)",
     :arglists ([x])},
    even? {:arglists ([num])},
    every-pred
    {:doc
     "Takes a set of predicates and returns a function f that returns true if all of its\n   composing predicates return a logical true value against all of its arguments, else it returns\n   false. Note that f is short-circuiting in that it will stop execution on the first\n   argument that triggers a logical false result against the original predicates.",
     :arglists ([p] [p1 p2] [p1 p2 p3] [p1 p2 p3 & ps])},
    every?
    {:doc
     "Returns true if (pred x) is logical true for every x in coll, else\n  false.",
     :arglists ([pred coll])},
    ex-cause
    {:doc
     "Returns exception cause if ex is an ExceptionInfo.\n   Otherwise returns nil.",
     :arglists ([ex])},
    ex-data
    {:doc
     "Returns exception data (a map) if ex is an IExceptionInfo.\n   Otherwise returns nil.",
     :arglists ([ex])},
    ex-info
    {:doc
     "Create an instance of ExceptionInfo, a RuntimeException subclass\n   that carries a map of additional data.",
     :arglists ([msg map] [msg map cause])},
    ex-message
    {:doc
     "Returns the message attached to ex. Defaults to str on unsupported Exceptions.\n   Otherwise returns nil.",
     :arglists ([ex])},
    extend-protocol
