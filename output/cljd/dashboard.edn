{:meta
 {:dialect-tag "cljd",
  :dialect-name "ClojureDart",
  :clojure-version "1.12.4",
  :compared-at "2026-07-09T07:56:23Z"},
 :divergences
 [{:id :dart-host,
   :title "Host runtime is Dart, not the JVM",
   :category-id :jvm-statics,
   :rationale
   "Interop targets Dart libraries (`dart:core`,\n                    `dart:math`, `dart:io`, `dart:async`,\n                    `dart:isolate`). JVM-static names\n                    (System/getenv, Math/PI, java.io.File) do not\n                    resolve; equivalents come from the corresponding\n                    `dart:*` library via `(:require [\"dart:...\" :as\n                    ...])`.",
   :since "cljd-0.1",
   :doc-link "https://github.com/Tensegritics/ClojureDart"}
  {:id :aot-only-compilation-model,
   :title "AOT-compiled to Dart; no runtime eval",
   :category-id :macros,
   :rationale
   "ClojureDart compiles ahead of time to Dart source,\n                    which Dart itself then compiles. `eval`,\n                    `load-string`, and `read-string`-then-evaluate\n                    have no runtime equivalent. Macro expansion\n                    happens only at compile time.",
   :since "cljd-0.1",
   :affected
   [clojure.core/eval clojure.core/load-string clojure.core/load-file]}
  {:id :no-jvm-concurrency-primitives,
   :title "Concurrency follows Dart's isolate model",
   :category-id :concurrency,
   :rationale
   "Dart has single-threaded event loops with isolates\n                    for parallel work. Refs, agents, and the JVM's\n                    java.util.concurrent vocabulary do not translate;\n                    cljd.core surfaces atoms and provides a\n                    Dart-async-flavored alternative.",
   :since "cljd-0.1",
   :doc-link "https://dart.dev/language/concurrency"}
  {:id :reader-conditional-cljd,
   :title "Reader conditional :clj does not fire under ClojureDart",
   :category-id :reader,
   :rationale
   "ClojureDart uses :cljd for its own branches and\n                    :cljd/clj-host for compile-time JVM-side code.\n                    Portable code that targets ClojureDart must\n                    use :cljd; code under :clj is invisible.",
   :since "cljd-0.1",
   :doc-link
   "https://github.com/Tensegritics/ClojureDart/blob/main/doc/differences.md"}
  {:id :type-hint-syntax-extended,
   :title "Extended type-hint syntax `^#/(Type ...)`",
   :category-id :type-system,
   :rationale
   "ClojureDart introduces `#/`-prefixed type\n                    expressions to attach Dart type annotations to\n                    forms (e.g. `^#/(List String) xs`). The portable\n                    `^Type sym` syntax is also supported.",
   :since "cljd-0.1"}
  {:id :stdlib-partial,
   :title "Several Clojure (JVM) namespaces have no cljd analogue",
   :category-id :namespaces,
   :rationale
   "ClojureDart ships cljd.core, .string, .set, .walk,\n                    .test, .template, .math, .data, .edn, .zip plus\n                    Dart-specific cljd.flutter and cljd.reader. The\n                    canonical clojure.pprint, .core.protocols,\n                    .core.reducers, .spec.alpha, .datafy, .instant\n                    are not present.",
   :since "cljd-0.1"}
  {:id :static-analysis-surface,
   :title "Surface measured via static source analysis",
   :category-id :namespaces,
   :rationale
   "The census reads .cljd source forms directly\n                    rather than calling ns-publics at runtime. Some\n                    metadata that requires evaluation (computed\n                    `:arglists`, runtime-attached docs) is not\n                    captured. The captured surface is the set of\n                    `def` / `defn` / `defmacro` / `definline` forms\n                    visible to the reader; matches `(meta var)` for\n                    plain definitions.",
   :since "cljd-0.1"}],
