 :divergences
 [{:id :go-host,
   :title "Host runtime is Go, not the JVM",
   :category-id :jvm-statics,
   :rationale
   "Interop targets Go packages, not java.lang.*.\n                    JVM-static names (System/getenv, Math/PI,\n                    java.io.File) do not resolve; equivalents are\n                    reached via Joker's batteries-included\n                    joker.os, joker.filepath, joker.http, etc.",
   :since "joker-1.0",
   :doc-link "https://github.com/candid82/joker"}
  {:id :subset-by-design,
   :title "Joker is a deliberate subset of Clojure",
   :category-id :namespaces,
   :rationale
   "Joker targets scripting and linting; it ships\n                    joker.core, joker.string, joker.set, joker.walk,\n                    joker.test, joker.template, joker.pprint,\n                    joker.math. clojure.edn, .zip, .data,\n                    .core.protocols, .core.reducers, .datafy,\n                    .instant, .spec.alpha are not implemented.",
   :since "joker-1.0",
   :doc-link "https://github.com/candid82/joker#joker"}
  {:id :no-spec,
   :title "clojure.spec.alpha is not implemented",
   :category-id :namespaces,
   :rationale
   "Spec's macro and dynamic-registry design does\n                    not fit Joker's lint-time analysis. Code that\n                    uses spec must guard with a :joker reader\n                    conditional.",
   :since "joker-1.0",
   :affected
   [clojure.spec.alpha/def
    clojure.spec.alpha/valid?
    clojure.spec.alpha/conform]}
  {:id :lint-time-types,
   :title "Joker performs lint-time type checking",
   :category-id :type-system,
   :rationale
   "Many shape errors that Clojure (JVM) reports at\n                    runtime are reported at lint time by Joker\n                    (joker --lint). This shifts the failure mode\n                    but does not change the runtime semantics of\n                    correct code.",
   :since "joker-1.0",
   :doc-link "https://github.com/candid82/joker#linter-mode"}
  {:id :no-transducer-arities,
   :title "Several core fns lack the single-arg transducer arity",
   :category-id :collections,
   :rationale
   "`(map f)`, `(filter pred)`, etc. -- the transducer\n                    forms -- are not all implemented. Calling\n                    `(into [] (map inc) coll)` with the single-arg\n                    transducer form raises an arity error. The\n                    sequence-returning forms (`(map f coll)`) work\n                    as expected.",
   :since "joker-1.0",
   :affected
   [clojure.core/map
    clojure.core/filter
    clojure.core/remove
    clojure.core/take
    clojure.core/drop]}
  {:id :no-print-dynvars,
   :title
   "*print-namespace-maps* / *print-length* / *print-level* not exposed",
   :category-id :printer,
   :rationale
   "Joker's pr-str emits a canonical form without\n                    exposing these binding-controlled dynvars to\n                    user code. Portable code that depends on\n                    binding them must guard with a :joker reader\n                    conditional.",
   :since "joker-1.0",
   :affected
   [clojure.core/*print-namespace-maps*
    clojure.core/*print-length*
    clojure.core/*print-level*]}
  {:id :reader-conditional-joker,
   :title "Reader conditional :clj does not fire under Joker",
   :category-id :reader,
   :rationale
   "Joker uses :joker for its own branches. Code\n                    under :clj is not evaluated by Joker's reader.",
   :since "joker-1.0"}],
